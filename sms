
# SCHOOL MANAGEMENT SYSTEM

students = {}
teachers = {}
examinations = {}

admin_username = "admin"
admin_password = "1234"


# ADMIN LOGIN
def login():
    print("\n===== ADMIN LOGIN =====")

    username = input("Enter username: ")
    password = input("Enter password: ")

    if username == admin_username and password == admin_password:
        print("\nLogin successful!")
        return True
    else:
        print("\nInvalid username or password!")
        return False


# REGISTER STUDENT
def register_student():
    print("\n===== STUDENT REGISTRATION =====")

    admission = input("Admission number: ")

    if admission in students:
        print("Student already exists!")
        return

    name = input("Student name: ")
    age = input("Student age: ")
    student_class = input("Student class: ")

    students[admission] = {
        "name": name,
        "age": age,
        "class": student_class
    }

    print("Student registered successfully!")


# VIEW STUDENTS
def view_students():
    print("\n===== STUDENT RECORDS =====")

    if not students:
        print("No students registered.")
        return

    for admission, details in students.items():
        print("\nAdmission:", admission)
        print("Name:", details["name"])
        print("Age:", details["age"])
        print("Class:", details["class"])


# SEARCH STUDENT
def search_student():
    admission = input("Enter admission number: ")

    if admission in students:
        print("\nStudent found!")
        print(students[admission])
    else:
        print("Student not found!")


# DELETE STUDENT
def delete_student():
    admission = input("Enter admission number: ")

    if admission in students:
        del students[admission]
        print("Student deleted successfully!")
    else:
        print("Student not found!")


# REGISTER TEACHER
def register_teacher():
    teacher_id = input("Enter teacher ID: ")

    if teacher_id in teachers:
        print("Teacher already exists!")
        return

    name = input("Enter teacher name: ")
    subject = input("Enter subject: ")

    teachers[teacher_id] = {
        "name": name,
        "subject": subject
    }

    print("Teacher registered successfully!")


# VIEW TEACHERS
def view_teachers():
    print("\n===== TEACHER RECORDS =====")

    if not teachers:
        print("No teachers registered.")
        return

    for teacher_id, details in teachers.items():
        print("\nTeacher ID:", teacher_id)
        print("Name:", details["name"])
        print("Subject:", details["subject"])


# ENTER EXAMINATION MARKS
def enter_marks():
    admission = input("Enter student admission number: ")

    if admission not in students:
        print("Student not found!")
        return

    subject = input("Enter subject: ")

    try:
        marks = float(input("Enter marks (0-100): "))
        if not 0 <= marks <= 100:
            print("Marks must be between 0 and 100!")
            return
    except ValueError:
        print("Please enter valid marks!")
        return

    examinations.setdefault(admission, {})
    examinations[admission][subject] = marks

    print("Examination marks saved!")


# VIEW EXAMINATION RESULTS
def view_results():
    admission = input("Enter student admission number: ")

    if admission not in students:
        print("Student not found!")
        return

    results = examinations.get(admission, {})

    if not results:
        print("No examination results found!")
        return

    print("\n===== EXAMINATION RESULTS =====")
    print("Student:", students[admission]["name"])

    for subject, marks in results.items():
        print(subject, ":", marks)


# MAIN MENU
def main_menu():

    while True:
        print("\n================================")
        print("   SCHOOL MANAGEMENT SYSTEM")
        print("================================")

        print("1. Register Student")
        print("2. View Students")
        print("3. Search Student")
        print("4. Delete Student")
        print("5. Register Teacher")
        print("6. View Teachers")
        print("7. Enter Examination Marks")
        print("8. View Examination Results")
        print("9. Exit")

        choice = input("\nChoose an option: ")

        if choice == "1":
            register_student()

        elif choice == "2":
            view_students()

        elif choice == "3":
            search_student()

        elif choice == "4":
            delete_student()

        elif choice == "5":
            register_teacher()

        elif choice == "6":
            view_teachers()

        elif choice == "7":
            enter_marks()

        elif choice == "8":
            view_results()

        elif choice == "9":
            print("Thank you for using the system!")
            break

        else:
            print("Invalid choice! Try again.")


# START PROGRAM
if login():
    main_menu()
